# Mesure d'audience Umami (sans cookie), décrite dans /privacy-policy/.
#
# Le script est actif par défaut, avec les valeurs de production inscrites dans
# src/layouts/BaseLayout.astro. Ces variables ne servent qu'à les surcharger.

# Pointer une autre instance Umami (préproduction, migration de serveur)
# PUBLIC_UMAMI_SRC=https://umami.exemple.fr/script.js
# PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Couper complètement le suivi (préproduction, environnement de test)
# PUBLIC_UMAMI_DISABLED=1
