---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBox from '../components/AuthorBox.astro';
import ContactSection from '../components/ContactSection.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Disclaimer from '../components/Disclaimer.astro';
import JsonLd from '../components/JsonLd.astro';
import { formatDate } from '../lib/site';

const { page } = Astro.props;

/** Pages de service : ni date d'article, ni avertissement, ni encart auteur. */
const SERVICE_PAGES = ['/nous-contacter/', '/privacy-policy/', '/a-propos-de-ce-site/'];
const isArticle = !SERVICE_PAGES.includes(page.url);
/** La politique de confidentialité affiche sa date sans être un article. */
const showDate = isArticle || page.url === '/privacy-policy/';
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  ogImage={page.ogImage}
  modified={page.modified}
>
  <JsonLd slot="head" page={page} type={isArticle ? 'article' : 'page'} />

  <SiteHeader />

  <main id="content">
    <article class="single">
      <div class="single__inner">
        <Breadcrumb items={page.breadcrumb} />

        <h1 class="page-title">{page.h1}</h1>

        {
          showDate && page.modified && (
            <p class="page-meta">
              Mis à jour le <time datetime={page.modified}>{formatDate(page.modified)}</time>
            </p>
          )
        }

        {
          page.featured && (
            <figure class="featured-image">
              <img
                src={page.featured.src}
                srcset={page.featured.srcset || undefined}
                sizes="(max-width: 640px) 100vw, 640px"
                width={page.featured.width}
                height={page.featured.height}
                alt={page.featured.alt || page.h1}
              />
            </figure>
          )
        }

        <div class="entry-content" set:html={page.content} />

        <RelatedLinks url={page.url} />

        {isArticle && <Disclaimer />}

        {isArticle && <AuthorBox />}

        <hr class="hr-divider" />

        <ContactSection />
      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
