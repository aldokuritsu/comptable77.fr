---
/**
 * Pied de page. La variante « home » reprend la couleur de séparateur
 * utilisée sur la page d'accueil du site d'origine.
 */
const { variant = 'default' } = Astro.props;
const isHome = variant === 'home';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__logo">
    <a href="/">
      <img
        src="/wp-content/uploads/2021/10/cropped-logo-comptable77.png"
        alt="Comptable77.fr"
        width="500"
        height="100"
      />
    </a>
  </div>

  <hr class="site-footer__divider" style={isHome ? '--divider-color:#D5D5D5' : undefined} />

  <div class="site-footer__bottom">
    <p class="site-footer__left">
      Site d'information indépendant sur la création et la gestion d'entreprise
      en Seine-et-Marne. <a href="/a-propos-de-ce-site/">À propos</a> ·
      <a href="/nous-contacter/">Nous contacter</a>
    </p>
    <p class="site-footer__right">
      © {year} comptable77.fr. Ce site n’enregistre pas de cookies.
      <a href="/privacy-policy/">Politique de confidentialité</a>
    </p>
  </div>
</footer>
