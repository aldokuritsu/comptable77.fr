---
/**
 * Pied de page. La variante « home » reprend les textes et la couleur de
 * séparateur utilisés sur la page d'accueil du site d'origine.
 */
const { variant = 'default' } = Astro.props;
const isHome = variant === 'home';
---

<footer class="site-footer">
  <div class="site-footer__logo">
    <a href="/">
      <img
        src="/wp-content/uploads/2021/10/cropped-logo-comptable77.png"
        alt="Comptable77.fr"
        width="500"
        height="100"
      />
    </a>
  </div>

  <hr class="site-footer__divider" style={isHome ? '--divider-color:#D5D5D5' : undefined} />

  <div class="site-footer__bottom">
    <p class="site-footer__left">
      {
        isHome
          ? 'Vous aimeriez utiliser ce site comme vitrine de votre activité ? '
          : 'Vous avez un cabinet comptable ? '
      }<a href="/a-propos-de-ce-site/">Lisez notre page «&nbsp;à propos&nbsp;»</a>
    </p>
    <p class="site-footer__right">
      {
        isHome ? (
          <>
            © Tous droits réservés 2021.{' '}
            <a href="/privacy-policy/">Politique de confidentialité</a>
          </>
        ) : (
          '© Tous droits réservés 2021. Ce site n’enregistre pas de cookies.'
        )
      }
    </p>
  </div>
</footer>
