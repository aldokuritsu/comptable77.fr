---
import TopBanner from './TopBanner.astro';
import TopBar from './TopBar.astro';
import Icons from './Icons.astro';
import nav from '../data/nav.json';

const { pathname } = Astro.url;
---

<header>
  <TopBanner />
  <TopBar />

  <div class="site-logo">
    <a href="/">
      <img
        src="/wp-content/uploads/2021/10/cropped-logo-comptable77.png"
        alt="Comptable77.fr"
        width="500"
        height="100"
      />
    </a>
  </div>

  <nav class="site-nav" data-open="false" aria-label="Navigation principale">
    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Menu">
      <Icons name="bars" />
    </button>
    <ul class="site-nav__list">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const nav = document.querySelector('.site-nav');
  const toggle = nav?.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = nav.dataset.open === 'true';
    nav.dataset.open = String(!open);
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
