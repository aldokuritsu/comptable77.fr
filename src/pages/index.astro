---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import home from '../data/home.json';
import pages from '../data/pages.json';

const meta = pages.find((page) => page.url === '/');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogType="website"
  modified={meta.modified}
>
  <TopBar />

  <div class="home-logo">
    <a href="/">
      <img
        src="/wp-content/uploads/2021/10/logo-comptable77.png"
        alt="Comptable77.fr"
        width="500"
        height="100"
      />
    </a>
  </div>

  <main id="content">
    <!-- Bandeau principal -->
    <section class="hero">
      <div class="hero__overlay"></div>
      <div class="hero__inner">
        <div class="hero__col">
          <h1 class="hero__title">{home.heroHeading}</h1>
          <p class="hero__text">
            Etre entrepreneur c’est une vocation. Ne perdez pas de temps avec ce
            qui ne vous intéresse pas : nous sommes là pour vous aider dans tout
            ce qui vous ennuie.
          </p>
        </div>
      </div>
    </section>

    <!-- Notre but -->
    <section class="purpose">
      <div class="purpose__inner">
        <div class="purpose__heading">
          <h2>{home.butHeading}</h2>
        </div>
        <div class="purpose__text" set:html={home.butText} />
      </div>
    </section>

    <!-- Nos rubriques -->
    <section class="topics">
      <div class="topics__inner">
        <div class="topics__intro">
          <h2>{home.rubHeading}</h2>
          <div class="topics__lead" set:html={home.rubText} />
        </div>
        <div class="topics__grid">
          {
            home.cards.map((card) => (
              <a class="topic-card" href={card.href}>
                <span class="topic-card__bg" />
                <span class="topic-card__content">
                  <span class="topic-card__title">{card.title}</span>
                  <span class="topic-card__desc">{card.desc}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- A propos -->
    <section class="about">
      <div class="about__inner">
        <div class="about__heading">
          <hr class="about__divider" />
          <h2>{home.aproposHeading}</h2>
        </div>
        <div class="about__text" set:html={home.aproposText} />
      </div>
    </section>

    <!-- Dernières publications -->
    <section class="latest">
      <div class="latest__inner">
        <h2 class="latest__title">{home.postsHeading}</h2>
        <div class="latest__grid">
          {
            home.posts.map((post) => (
              <article class="post-card">
                <a class="post-card__thumb" href={post.href}>
                  <img
                    src={post.img}
                    srcset={post.srcset || undefined}
                    sizes="(max-width: 767px) 100vw, 360px"
                    alt={post.title}
                    loading="lazy"
                  />
                </a>
                <h3 class="post-card__title">
                  <a href={post.href}>{post.title}</a>
                </h3>
                <div class="post-card__excerpt">
                  <p>{post.excerpt}</p>
                </div>
                <a class="post-card__more" href={post.href}>{post.more}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter variant="home" />
</BaseLayout>

<style>
  /* --------------------------------------------------------------------
     Logo d'accueil
     -------------------------------------------------------------------- */
  .home-logo {
    text-align: center;
    padding: 10px 0;
  }

  .home-logo img {
    display: inline-block;
    vertical-align: middle;
    width: 500px;
    max-width: 100%;
    height: auto;
  }

  /* --------------------------------------------------------------------
     Bandeau principal
     -------------------------------------------------------------------- */
  .hero {
    position: relative;
    background-image: url('/wp-content/uploads/2021/10/entrepreneur-illustration-accueil.jpeg');
    background-position: bottom center;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--c-secondary);
    opacity: 0.8;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: 10px;
    min-height: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__col {
    margin-top: -5%;
  }

  .hero__title {
    font-family: var(--f-merriweather);
    font-size: 50px;
    font-weight: 100;
    line-height: 1.2em;
    text-transform: capitalize;
    text-align: center;
    color: #fff;
    margin: 0;
  }

  .hero__text {
    max-width: 530px;
    padding-inline: 10px;
    margin: 20px auto 0;
    font-family: var(--f-montserrat);
    font-size: 16px;
    font-weight: 200;
    line-height: 1.5;
    text-align: center;
    color: #fff;
  }

  /* --------------------------------------------------------------------
     Notre but
     -------------------------------------------------------------------- */
  .purpose {
    margin: 50px 0;
  }

  .purpose__inner {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    align-items: center;
  }

  .purpose__heading {
    width: 32.75%;
    padding-left: 30px;
    border-left: 4px solid var(--c-gold);
  }

  .purpose__heading h2 {
    font-family: var(--f-merriweather);
    font-size: 50px;
    font-weight: 300;
    line-height: 1.4em;
    text-transform: capitalize;
    color: var(--c-heading);
    margin: 0;
  }

  .purpose__text {
    width: 67.25%;
    padding: 0 35px 10px 0;
    align-self: flex-end;
    columns: 2;
    column-gap: 30px;
    font-family: var(--f-montserrat);
    font-size: 16px;
    font-weight: 200;
    line-height: 1.5;
    color: var(--c-muted);
  }

  .purpose__text :global(p) {
    margin: 0;
  }

  /* --------------------------------------------------------------------
     Nos rubriques
     -------------------------------------------------------------------- */
  .topics {
    background: var(--c-secondary);
  }

  .topics__inner {
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    min-height: 1006px;
  }

  .topics__intro {
    width: 50%;
    padding: 0 150px 0 10px;
  }

  .topics__intro h2 {
    font-family: var(--f-merriweather);
    font-size: 50px;
    font-weight: 300;
    line-height: 1.4em;
    letter-spacing: 1.2px;
    text-transform: capitalize;
    color: #fff;
    margin: 0;
  }

  .topics__lead {
    margin-top: 15px;
    font-family: var(--f-montserrat);
    font-size: 16px;
    font-weight: 200;
    line-height: 1.5;
    color: #fff;
  }

  .topics__lead :global(p) {
    margin: 0;
  }

  .topics__grid {
    width: 50%;
    padding-inline: 10px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .topic-card {
    position: relative;
    display: block;
    min-height: 284px;
    background: #fff;
    border-top: 4px solid #6c6b7d;
    box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.25);
    overflow: hidden;
    text-decoration: none;
  }

  .topic-card__bg {
    position: absolute;
    inset: 0;
    background: transparent;
    transition: background 0.3s;
  }

  .topic-card:hover .topic-card__bg {
    background: #ffffff;
  }

  .topic-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    min-height: 280px;
    padding: 35px;
    text-align: center;
  }

  .topic-card__title {
    display: block;
    margin-bottom: 15px;
    font-family: var(--f-montserrat);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    text-transform: capitalize;
    color: var(--c-heading);
  }

  .topic-card__desc {
    display: block;
    font-family: var(--f-montserrat);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--c-muted);
  }

  /* --------------------------------------------------------------------
     A propos
     -------------------------------------------------------------------- */
  .about {
    padding: 50px 0;
  }

  .about__inner {
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    align-items: center;
  }

  .about__heading {
    width: 28%;
    align-self: flex-start;
  }

  .about__divider {
    width: 90%;
    margin: 15px 0;
    border: 0;
    border-top: 1px solid #000;
  }

  .about__heading h2 {
    font-family: var(--f-merriweather);
    font-size: 40px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 12px;
    color: #000;
    margin: 0;
  }

  .about__text {
    width: 72%;
    padding: 0 150px 0 50px;
    font-family: var(--f-roboto);
    font-size: 16px;
    font-weight: 300;
    line-height: 2em;
    color: #666;
  }

  .about__text :global(p) {
    margin: 0 0 14.4px;
  }

  /* --------------------------------------------------------------------
     Dernières publications
     -------------------------------------------------------------------- */
  .latest {
    padding: 30px;
  }

  .latest__inner {
    max-width: var(--container);
    margin-inline: auto;
  }

  .latest__title {
    font-family: var(--f-roboto);
    font-size: 32px;
    font-weight: 600;
    line-height: 1;
    color: var(--c-secondary);
    margin: 8px 0 16px;
  }

  .latest__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 30px;
    row-gap: 35px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
  }

  .post-card__thumb {
    display: block;
    margin-bottom: 20px;
  }

  .post-card__thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  .post-card__title {
    font-family: var(--f-roboto);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2em;
    color: var(--c-secondary);
    margin: 0 0 10px;
  }

  .post-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .post-card__excerpt {
    font-family: var(--f-roboto);
    font-size: 14px;
    line-height: 1.5em;
    color: #777;
    margin-bottom: 10px;
  }

  .post-card__excerpt p {
    margin: 0;
  }

  .post-card__more {
    font-family: var(--f-roboto);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--c-accent);
    margin-top: auto;
    align-self: flex-start;
  }

  /* --------------------------------------------------------------------
     Responsive
     -------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .hero {
      background-position: -290px 0;
    }

    .hero__inner {
      min-height: 550px;
    }

    .hero__title {
      font-size: 60px;
    }

    .purpose {
      margin: 80px 0;
      padding-left: 25px;
    }

    .purpose__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .purpose__heading,
    .purpose__text {
      width: 100%;
    }

    .purpose__heading h2 {
      font-size: 38px;
    }

    .purpose__text {
      columns: 1;
      padding: 0 25px 0 0;
    }

    .topics__inner {
      flex-direction: column;
      min-height: 0;
    }

    .topics__intro {
      width: 100%;
      padding: 80px;
      text-align: center;
    }

    .topics__grid {
      width: 100%;
      padding: 0 15px 80px;
    }

    .about {
      padding: 100px 25px;
    }

    .about__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .about__heading,
    .about__text {
      width: 100%;
    }

    .about__text {
      padding: 0 50px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      background-position: -228px 0;
    }

    .hero__title {
      font-size: 45px;
    }

    .purpose {
      margin: 80px 0;
      padding: 0 15px;
    }

    .purpose__text {
      margin-top: 30px;
      padding: 0;
    }

    .topics__intro {
      padding: 80px 20px 50px;
    }

    .topics__intro h2 {
      font-size: 36px;
    }

    .topics__grid {
      grid-template-columns: 1fr;
    }

    .about {
      padding: 50px 20px;
    }

    .about__heading h2 {
      font-size: 35px;
    }

    .about__text {
      padding: 25px 0 0;
    }

    .latest__grid {
      grid-template-columns: 1fr;
    }

  }
</style>
